{
	"name": "@drillcoder/ethers-rpc-pool",
	"version": "1.0.0",
	"description": "A resilient TypeScript JSON-RPC endpoint pool for ethers v6 and Node.js",
	"keywords": [
		"ethereum",
		"ethers",
		"json-rpc",
		"rpc",
		"failover",
		"load-balancing",
		"typescript"
	],
	"author": "drillcoder",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "npm@11.19.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drillcoder/ethers-rpc-pool.git"
	},
	"bugs": {
		"url": "https://github.com/drillcoder/ethers-rpc-pool/issues"
	},
	"homepage": "https://github.com/drillcoder/ethers-rpc-pool#readme",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project test/tsconfig.json",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "npm run lint -- --fix",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"pack:test": "node test/package/run.mjs",
		"quality": "npm run build && npm run typecheck && npm run lint && npm run test:coverage && npm run pack:test"
	},
	"peerDependencies": {
		"ethers": "^6.0.0"
	},
	"devDependencies": {
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/github": "12.0.10",
		"@semantic-release/npm": "13.2.0",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-n": "^18.3.0",
		"ethers": "^6.17.0",
		"globals": "^17.12.0",
		"semantic-release": "25.0.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "^5.0.0"
	}
}
